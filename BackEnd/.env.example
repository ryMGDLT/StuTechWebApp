# Server-only variables (never use VITE_ prefix).
# Copy to .env and adjust for local development.
# Never commit .env files.

PORT=5000

# Comma-separated allowed browser origins for CORS
CORS_ORIGIN=http://localhost:3000

# Rate limiting for public lead endpoints (contact, get-started)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=10

# Optional: webhook URL for lead submissions (future CRM/email integration)
# CONTACT_WEBHOOK_URL=https://example.com/webhook
