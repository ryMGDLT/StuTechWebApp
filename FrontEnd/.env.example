# Client-safe variables only (exposed to the browser bundle).
# Copy to .env and adjust for local development.
# Never commit .env files.

# Backend API base URL.
# Leave empty to use the Vite dev proxy (/api → http://localhost:5000).
# For production with a separate API host, set the full origin (no trailing slash).
# VITE_API_BASE_URL=
VITE_API_BASE_URL=
